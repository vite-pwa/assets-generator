{
  "name": "@vite-pwa/assets-generator",
  "type": "module",
  "version": "1.0.4",
  "packageManager": "pnpm@11.25.0",
  "description": "Zero-config PWA Assets Generator",
  "author": "antfu <anthonyfu117@hotmail.com>",
  "license": "MIT",
  "funding": "https://github.com/sponsors/antfu",
  "homepage": "https://github.com/vite-pwa/assets-generator#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/vite-pwa/assets-generator.git"
  },
  "bugs": "https://github.com/vite-pwa/assets-generator/issues",
  "keywords": [
    "sharp",
    "sharp-ico",
    "pwa",
    "pwa icons generator",
    "pwa assets generator"
  ],
  "sideEffects": false,
  "exports": {
    ".": "./dist/index.mjs",
    "./config": "./dist/config.mjs",
    "./presets": "./dist/presets/index.mjs",
    "./presets/minimal": "./dist/presets/minimal.mjs",
    "./presets/minimal-2023": "./dist/presets/minimal-2023.mjs",
    "./api": "./dist/api/index.mjs",
    "./api/instructions": "./dist/api/instructions.mjs",
    "./api/generate-html-markup": "./dist/api/generate-html-markup.mjs",
    "./api/generate-manifest-icons-entry": "./dist/api/generate-manifest-icons-entry.mjs",
    "./api/generate-assets": "./dist/api/generate-assets.mjs",
    "./package.json": "./package.json"
  },
  "types": "dist/index.d.mts",
  "typesVersions": {
    "*": {
      "config": [
        "./dist/config.d.mts"
      ],
      "presets": [
        "./dist/presets/index.d.mts"
      ],
      "presets/minimal": [
        "./dist/presets/minimal.d.mts"
      ],
      "presets/minimal-2023": [
        "./dist/presets/minimal-2023.d.mts"
      ],
      "api": [
        "./dist/api/index.d.mts"
      ],
      "api/instructions": [
        "./dist/api/instructions.d.mts"
      ],
      "api/generate-html-markup": [
        "./dist/api/generate-html-markup.d.mts"
      ],
      "api/generate-manifest-icons-entry": [
        "./dist/api/generate-manifest-icons-entry.d.mts"
      ],
      "api/generate-assets": [
        "./dist/api/generate-assets.d.mts"
      ]
    }
  },
  "bin": {
    "pwa-assets-generator": "./bin/pwa-assets-generator.mjs"
  },
  "files": [
    "bin",
    "dist"
  ],
  "engines": {
    "node": ">=20.19.0"
  },
  "scripts": {
    "build": "tsdown",
    "lint": "eslint .",
    "lint:fix": "nr lint --fix",
    "prepublishOnly": "pnpm build",
    "release": "bumpp",
    "run-playground": "pnpm -C playground run build",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "update-workflows": "pnpx actions-up -y"
  },
  "dependencies": {
    "cac": "^7.0.0",
    "consola": "^3.4.2",
    "picocolors": "^1.1.1",
    "sharp": "^0.35.4",
    "sharp-ico": "^0.1.5",
    "unconfig": "^7.5.0"
  },
  "devDependencies": {
    "@antfu/eslint-config": "^9.5.1",
    "@antfu/ni": "^30.5.0",
    "@arethetypeswrong/core": "^0.18.5",
    "@types/debug": "^4.1.13",
    "@types/node": "^22.20.2",
    "bumpp": "^12.3.0",
    "eslint": "^10.10.0",
    "publint": "^0.3.24",
    "tsdown": "^0.23.0",
    "typescript": "^6.0.3",
    "vitest": "^5.0.0"
  }
}
